# Quiz Quest - Environment Configuration Example
# Copy this file to .env and insert your API key.

# Google Gemini API Key (Get yours free from https://aistudio.google.com/)
GEMINI_API_KEY=your_gemini_api_key_here

# Gemini Model Selection (Recommended: gemini-3.5-flash-lite or gemini-3.8-flash)
GEMINI_MODEL=gemini-3.5-flash-lite
